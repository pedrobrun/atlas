PORT=4100
LOG_LEVEL=info
DATABASE_URL=postgres://invoicing:invoicing@localhost:5432/invoicing

# Bearer token portal and erp-sync present to this service
INVOICING_SERVICE_TOKEN=

# procure-api, for budget consumption and vendor payout accounts
PROCURE_API_URL=http://localhost:4000
PROCURE_SERVICE_TOKEN=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PROCUREMENT_EVENTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/procurement-events.fifo
INVOICE_BUCKET=northwind-ap-invoices

# Shared secret in the SendGrid Inbound Parse webhook URL (?key=...)
INBOUND_EMAIL_SECRET=

OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-2024-08-06
EXTRACTION_MIN_CONFIDENCE=0.85

MATCH_PRICE_TOLERANCE_BPS=200
MATCH_PRICE_TOLERANCE_MAX_CENTS=5000

STRIPE_SECRET_KEY=
PAYMENT_RUN_HOUR_UTC=14
PAYMENT_RUN_HORIZON_DAYS=3
