PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://procure:procure@localhost:5432/procure
PG_POOL_MAX=10

# Shared bearer token for portal, invoicing, erp-sync and legacy-approvals
PROCURE_SERVICE_TOKEN=

# SQS FIFO queue consumed by invoicing (credentials fall back to the ECS task role)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PROCUREMENT_EVENTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/procurement-events.fifo

APPROVAL_SLA_HOURS=48

SLACK_BOT_TOKEN=
SLACK_ESCALATIONS_CHANNEL=C0000000000

SENDGRID_API_KEY=
EMAIL_FROM=procurement@northwind-supply.example

PORTAL_BASE_URL=https://procurement.northwind-supply.example
# Signs "approve by link" tokens; legacy-approvals must use the same value
APPROVAL_LINK_SECRET=
LEGACY_APPROVALS_BASE_URL=https://approve.northwind-supply.example

DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_BASE64=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_HOST=account-d.docusign.com
DOCUSIGN_CONNECT_HMAC_KEY=
